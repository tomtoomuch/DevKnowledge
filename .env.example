# DevKnowledge — copier dans .env (non versionne), puis renseigner les deux mots de passe.
# Le compte administrateur n'est utilise que pour initialiser / administrer MongoDB.
MONGO_INITDB_ROOT_USERNAME=devknowledge_admin
MONGO_INITDB_ROOT_PASSWORD=

# Compte applicatif a privileges limites, cree lors du TOUT PREMIER demarrage
# d'un volume MongoDB vierge (pas sur un volume deja initialise).
MONGODB_APP_USERNAME=devknowledge_app
MONGODB_APP_PASSWORD=
MONGODB_DATABASE=devknowledge
MONGODB_AUTH_SOURCE=devknowledge

# Port interne de MongoDB dans le reseau Docker Compose.
MONGODB_PORT=27017

# Hors Docker seulement : MONGODB_HOST=localhost (dans Compose : mongodb).

# Port de la Gateway (interne et publie sur 127.0.0.1).
GATEWAY_PORT=3000

# Delai maximal du relais Gateway -> KMS, en millisecondes (1 a 60000).
KMS_TIMEOUT_MS=10000
# Hors Docker seulement : KMS_BASE_URL=http://127.0.0.1:8000

# Interface Angular locale via Nginx.
FRONTEND_PORT=4200

# Cookie de session Secure uniquement si l'interface est servie en HTTPS.
# Pour les ports locaux HTTP sur 127.0.0.1, conserver false.
AUTH_COOKIE_SECURE=false
